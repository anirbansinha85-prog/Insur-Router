# ============================================================================
# InsurRouter / VeloDocs — environment template
# ============================================================================
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# NOTE: nothing in this workspace calls dotenv. A `.env` file is NOT read
# automatically. Load it explicitly with Node's built-in flag:
#     node --env-file=.env ...
# or export the vars in your shell before running a command. See CLAUDE.md
# ("Running locally") for the exact commands.
# ============================================================================


# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. Read by lib/db/src/index.ts and
# lib/db/drizzle.config.ts; both throw on startup if it is missing.
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres


# ─── Per-process: PORT and BASE_PATH ─────────────────────────────────────────
# Every artifact requires PORT, and the web artifacts also require BASE_PATH;
# each throws at startup if its value is missing. The values differ per
# artifact, so they CANNOT all live in one .env — set them inline per command.
#
#   api-server     PORT=8080
#   insur-router   PORT=24791   BASE_PATH=/
#   doc-ingest     PORT=18815   BASE_PATH=/doc-ingest/
#   mockup-sandbox PORT=8081    BASE_PATH=/__mockup
#   rc-capture     PORT=23754   BASE_PATH=/rc-capture/
#
# Port the Vite dev servers proxy "/api" to. Defaults to 8080 if unset.
# API_PORT=8080


# ─── OCR engines (VeloDocs /doc-ingest) ──────────────────────────────────────
# Both are optional. The "stub" engine needs no key and returns fixed demo data.
# Selecting an engine without its key returns HTTP 400 with an explicit message.

# Engine "qwen-vl" — Alibaba DashScope, model qwen-vl-plus.
DASHSCOPE_API_KEY=

# The engine dropdown offers "PaddleOCR (requires PADDLEOCR_API_URL)", but that
# branch throws before reading any variable — no code reads PADDLEOCR_API_URL.
# Setting it does nothing until a text-to-MsaFields extractor is written.
# PADDLEOCR_API_URL=

# Engine "gpt-vision" — OpenAI, model gpt-4o.
OPENAI_API_KEY=

# Replit AI-Integrations proxy. If set, these take priority over OPENAI_API_KEY.
# Leave both blank when running outside Replit.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=


# ─── Dealer DMS (optional, not yet implemented) ──────────────────────────────
# Referenced only in the TODO comment above callDealerDMS() in
# artifacts/api-server/src/routes/ingest.ts. The DMS pull is a stub that
# synthesises records from the registration number; these are unused until a
# real DMS integration is written.
DMS_API_URL=
DMS_API_TOKEN=


# ─── Insurance provider credentials (optional) ───────────────────────────────
# api-executor.ts reads keys by convention: process.env[`${PROVIDER_CODE}_API_KEY`]
# where PROVIDER_CODE is the `code` column of the providers table. Add one line
# per provider you wire up, e.g.:
# HDFC_API_KEY=
# BAJAJ_API_KEY=


# ─── Playwright ──────────────────────────────────────────────────────────────
# Path to a Chromium binary, used by BOTH browser paths (policy submission in
# browser-executor.ts and portal scraping in ingest.ts).
#
# Leave BLANK off-Replit: Playwright then uses its own downloaded browser, which
# is what you want locally. Install it once with:
#     pnpm --filter @workspace/api-server exec playwright install chromium
#
# On Replit, set this to the Nix Chromium path — that also switches on the
# sandbox/GPU workaround flags that environment needs:
#   /nix/store/qa9cnw4v5xkxyip6mb9kxqfq1z4x2dx1-chromium-138.0.7204.100/bin/chromium
CHROMIUM_EXECUTABLE_PATH=


# ─── RC Capture (Expo mobile app) ────────────────────────────────────────────
# Host the mobile app calls for /api. Injected from REPLIT_DEV_DOMAIN on Replit.
# Its `dev` script is POSIX-only and Replit-specific — see CLAUDE.md.
# EXPO_PUBLIC_DOMAIN=


# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL defaults to "info". NODE_ENV=production disables pretty-printing.
# LOG_LEVEL=debug
# NODE_ENV=development
