{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed": "pnpm --filter @workspace/scripts run seed",
    "db:seed-owners": "pnpm --filter @workspace/scripts run seed-owners",
    "db:seed-applications": "pnpm --filter @workspace/scripts run seed-applications",
    "db:seed-pricelists": "pnpm --filter @workspace/scripts run seed-pricelists",
    "db:export-reports": "pnpm --filter @workspace/scripts run export-reports",
    "db:seed-users": "pnpm --filter @workspace/scripts run seed-users",
    "db:migrate-org": "pnpm --filter @workspace/scripts run migrate-org",
    "db:rls": "pnpm --filter @workspace/scripts run rls",
    "verify:records": "pnpm --filter @workspace/scripts run records",
    "verify:permissions": "pnpm --filter @workspace/scripts run permissions",
    "verify:agent": "pnpm --filter @workspace/scripts run agent",
    "verify:journey": "pnpm --filter @workspace/scripts run journey",
    "verify:ingest": "pnpm --filter @workspace/scripts run ingest",
    "verify:invoice": "pnpm --filter @workspace/scripts run invoice",
    "verify:autonomy": "pnpm --filter @workspace/scripts run autonomy",
    "verify:overview": "pnpm --filter @workspace/scripts run overview",
    "verify:channels": "pnpm --filter @workspace/scripts run channels",
    "verify:trace": "pnpm --filter @workspace/scripts run trace",
    "verify:ledger": "pnpm --filter @workspace/scripts run ledger",
    "verify:agents": "pnpm --filter @workspace/scripts run agents",
    "db:probe": "pnpm --filter @workspace/scripts run probe",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
