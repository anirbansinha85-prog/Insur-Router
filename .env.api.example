# The API server's environment.
#
# This exists because of one line that is NOT in it: `DATABASE_URL`.
#
# That is the table owner's connection. It owns every table and has `bypassrls`,
# so row-level security is inert for it — anything holding that string reads
# every dealership's customers and every password hash. The command-line tools
# need it (drizzle-kit, the seed scripts, `db:rls`), and those run as a person
# who already has the password. The server does not need it and must not have
# it: choosing the restricted role is not isolation while the unrestricted one
# is one import away, and that mistake would be a query that silently works.
#
# So `artifacts/api-server/src/app.ts` calls `refuseOwnerCredential()` at
# startup and will not boot with `DATABASE_URL` set. Run the server from this
# file and everything else from `.env`:
#
#     node --env-file=.env.api artifacts/api-server/dist/index.mjs
#     pnpm run db:push          # reads .env, needs the owner
#
# Keep it in step with `.env` — it is the same file minus that one line. On
# Windows:
#
#     Get-Content .env | Where-Object { $_ -notmatch '^DATABASE_URL=' } |
#       Set-Content .env.api
#
# Gitignored, like `.env`. This template is the tracked copy.


# ─── The three restricted roles ──────────────────────────────────────────────
# Each is one job, and the grants in lib/db/sql/rls.sql are the whole of what
# each may reach. `pnpm run db:rls` creates all three from these strings and
# then proves it by connecting as each and counting.

# Every request. Scoped by the session token the request sets on the connection,
# so with nobody signed in it reads nothing at all.
DATABASE_URL_APP=postgresql://ddms_app.PROJECTREF:APP_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Sign-in, and nothing but sign-in: users, sessions, and the staff master the
# departure check joins. Writes exactly one column, users.last_login_at.
DATABASE_URL_LOGIN=postgresql://ddms_login.PROJECTREF:LOGIN_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# The sync scheduler. Cross-tenant by definition — it syncs every dealership on
# a timer, which no session-scoped connection may do — so it holds the mirror
# and the graph for everyone, and no users, sessions or applications for anyone.
DATABASE_URL_WORKER=postgresql://ddms_worker.PROJECTREF:WORKER_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres


# ─── Everything else the server needs ────────────────────────────────────────
# Same values as .env. Copy them across rather than inventing new ones.

API_SERVICE_KEY=

# The dealer's DMS. Without these the mirror has nothing to pull and DDMS shows
# whatever was last synced, with a stale timestamp saying so.
DMS_API_URL=http://localhost:9090
DMS_API_KEY=

# Sync interval in milliseconds. 0 switches the scheduler off, which is what to
# use while working on anything that reads the mirror.
# DMS_SYNC_INTERVAL_MS=900000

# Model keys, for the composer and the explain panel. Both degrade to rules-only
# output without them, visibly rather than silently.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
