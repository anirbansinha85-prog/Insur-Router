{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "seed": "tsx --env-file-if-exists=../.env ./src/seed-providers.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed-owners": "tsx --env-file-if-exists=../.env ./src/seed-owners.ts",
    "seed-users": "tsx --env-file-if-exists=../.env ./src/seed-users.ts",
    "seed-applications": "tsx --env-file-if-exists=../.env ./src/seed-applications.ts",
    "seed-pricelists": "tsx --env-file-if-exists=../.env ./src/seed-pricelists.ts",
    "migrate-org": "tsx --env-file-if-exists=../.env ./src/migrate-org.ts",
    "org": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-org.ts",
    "parties": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-parties.ts",
    "export-reports": "tsx --env-file-if-exists=../.env ./src/export-reports.ts",
    "rls": "tsx --env-file-if-exists=../.env ./src/apply-rls.ts",
    "probe": "tsx --env-file-if-exists=../.env ./src/rls-probe.ts",
    "agent": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-agent.ts",
    "permissions": "tsx ../artifacts/api-server/src/scripts/verify-permissions.ts",
    "records": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-records.ts",
    "journey": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-journey.ts",
    "ingest": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-ingest.ts",
    "invoice": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-invoice.ts",
    "autonomy": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-autonomy.ts",
    "overview": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-overview.ts",
    "channels": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-channels.ts",
