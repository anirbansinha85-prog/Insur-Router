    "ledger": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-ledger.ts",
    "agents": "tsx --env-file=../.env.api --env-file=../.env ../artifacts/api-server/src/scripts/verify-agents.ts"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "@workspace/quoting": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "tsx": "catalog:"
