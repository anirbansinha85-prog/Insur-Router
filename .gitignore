# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# secrets — .env holds DATABASE_URL and provider/OCR API keys, never commit it.
# .env.example is the tracked template and is deliberately not ignored.
.env
.env.*
!.env.example
!.env.api.example

# drizzle-kit generate output — this workspace uses `push`, not migration files
lib/db/drizzle/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local session handover notes — personal working files, not project content
SESSION-*.md

# The mock DMS's own database. Seeded on first boot; deliberately not shared,
# because a checked-in fixture that drifts is worse than one that rebuilds.
artifacts/dms-mock/data/
